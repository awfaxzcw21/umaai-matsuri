--- /dev/null
+++ b/crates/matsuri-core/tests/softcap.rs
@@ -0,0 +1,78 @@
+//! 赛后奖励通道的 1200 软上限守门（报文一手：cid168 t54 大阪杯 速度 pre=1300、名义 7 → 实得 3）
+//!
+//! 为什么单独盯这条：剧本侧的三处入账里，**普通训练 / 演目稽古 / 発表会与终局奖励**都在
+//! `MatsuriGame` 自己手里（`settle_training` / `apply_reward`），一眼能找到；赛后奖励不一样，
+//! 它是引擎 `BaseGame::push_race_event` 造一条系统事件（`race_career` / `race_g{grade}` /
+//! `race_ura_*`）挂进事件流，数值由引擎在 `apply_event` 里落账 ⇒ 压缩只能接在剧本侧
+//! `Game::apply_event` 的前后（见 `game/traits.rs`）。
+//! 漏接的表现是**静默**的：低档位五维没过线时两边逐位相同，只有高档才差出量级。
+//!
+//! 两臂只差 `rules.status_soft_cap`（1200 / 0），事件 id、卡组、随机种子全一致 ⇒ 差值只来自压缩。
+//! 赛前取 1300（已过线）⇒ 每一维的实得应当恰好是未压增量的 **一半（向下取整）**。
+
+use std::sync::Arc;
+
+use anyhow::Result;
+use matsuri_core::testing::sample_game;
+use rand::SeedableRng;
+use rand::rngs::StdRng;
+use umaai_core::Data;
+use umasim::game::Game;
+
+/// 用 `key` 这条赛后奖励事件结算一次，返回五维各自的增量
+fn race_delta(cap: i32, key: &str) -> Result<[i32; 5]> {
+    let pre = [1300; 5];
+    let mut game = sample_game();
+    game.uma_mut().five_status = pre;
+    Arc::get_mut(&mut game.data)
+        .expect("sample_game 独占 data，可改写资产")
+        .rules
+        .status_soft_cap = cap;
+    let event = Data::get()?.system_event(key)?.clone();
+    let mut rng = StdRng::seed_from_u64(20261102);
+    game.apply_event(&event, 0, &mut rng)?;
+    let after = game.uma().five_status;
+    let mut delta = [0; 5];
+    for slot in 0..5 {
+        delta[slot] = after[slot] - pre[slot];
+    }
+    Ok(delta)
+}
+
+/// `cap <= 0` 时 `soft_cap_gain` 原样返回；过线则整笔减半（pre=1300 已全维过线）
+fn halved(gain: i32) -> i32 {
+    if gain > 0 { gain / 2 } else { gain }
+}
+
+#[test]
+fn career_race_reward_channel_applies_soft_cap() -> Result<()> {
+    let uncapped = race_delta(0, "race_career")?;
+    let capped = race_delta(1200, "race_career")?;
+    assert!(
+        uncapped.iter().sum::<i32>() > 0,
+        "未压那一臂也没有属性增量 ⇒ 赛后奖励不再走 `apply_event`，这条用例已失效"
+    );
+    for slot in 0..5 {
+        assert_eq!(
+            capped[slot],
+            halved(uncapped[slot]),
+            "赛后奖励第 {slot} 维：压缩没接进剧本侧 `Game::apply_event`"
+        );
+    }
+    Ok(())
+}
+
+#[test]
+fn optional_race_reward_channel_applies_soft_cap() -> Result<()> {
+    // 自选比赛走 `race_g{grade}`（G1–OP 四档），与目标赛同一条 apply 路径、不同事件
+    let uncapped = race_delta(0, "race_g1")?;
+    let capped = race_delta(1200, "race_g1")?;
+    assert!(
+        uncapped.iter().sum::<i32>() > 0,
+        "未压那一臂也没有属性增量 ⇒ 自选比赛不再走 `apply_event`，这条用例已失效"
+    );
+    for slot in 0..5 {
+        assert_eq!(capped[slot], halved(uncapped[slot]), "自选比赛第 {slot} 维没被压缩");
+    }
+    Ok(())
+}
