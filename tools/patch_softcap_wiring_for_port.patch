         let before = self.key_state();
+        // 赛后奖励吃 1200 软上限（剧本 15；报文实证）：入账前留一份赛前五维，
+        // 入账后按「过线部分减半」回填。脚本事件的属性收益不在已实证范围内 ⇒ 不套上限。
