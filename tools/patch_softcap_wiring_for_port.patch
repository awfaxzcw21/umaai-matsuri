diff --git a/crates/matsuri-core/src/game/softcap.rs b/crates/matsuri-core/src/game/softcap.rs
new file mode 100644
index 0000000..095c06e
--- /dev/null
+++ b/crates/matsuri-core/src/game/softcap.rs
@@ -0,0 +1,177 @@
+//! 属性软上限（剧本 15「1200 软上限」）
+//!
+//! 真机口径（2026-11-01 步骤 3 报文实证）：五维增量中**超出 1200 的部分减半**（向下取整）。
+//!
+//! 报文算例（同一训练、同一属性格，名义增量相同、赛前值不同 ⇒ 实得不同）：
+//! - pre = 1195、名义 30 → 实得 17（= 5 + ⌊25/2⌋）
+//! - pre = 1196、名义 14 → 实得 9（= 4 + ⌊10/2⌋）
+//! - pre = 1179、名义 38 → 实得 29（= 21 + ⌊17/2⌋）
+//! - pre ≥ 1200、名义 7 → 实得 3（= ⌊7/2⌋）
+//! - pre = 451、名义 7 → 实得 7（没过线，全额）
+//!
+//! 适用范围：普通训练 / 演目稽古 / 赛后奖励（含自选比赛）/ 発表会全能力奖励。
+//! **技能点不受软上限影响**（只有五维过线才打折）。
+
+use umaai_core::Array5;
+use umaai_core::gamedata::ActionValue;
+
+/// 属性软上限：增量中**超出 `cap` 的部分**减半（向下取整）
+///
+/// - `pre = 1195` / 满增量 30 → 5 + ⌊25/2⌋ = 17
+/// - `pre ≥ 1200` / 满增量 7 → ⌊7/2⌋ = 3
+///
+/// `cap <= 0` 视为关闭（增量原样返回）。
+pub(crate) fn soft_cap_gain(cap: i32, pre: i32, gain: i32) -> i32 {
+    if cap <= 0 || gain <= 0 {
+        return gain;
+    }
+    let below = gain.min((cap - pre).max(0));
+    below + (gain - below) / 2
+}
+
+/// 对一次入账的五维增量套软上限（`status_pt[5]` 的技能点不参与）
+///
+/// `pre` = 入账前的五维（逐维取，过线只看该维自己的赛前值）。
+pub(crate) fn apply_soft_cap(cap: i32, pre: &Array5, value: &mut ActionValue) {
+    if cap <= 0 {
+        return;
+    }
+    let gains = value.status_pt;
+    for (slot, (&p, &g)) in pre.iter().zip(gains.iter()).enumerate() {
+        value.status_pt[slot] = soft_cap_gain(cap, p, g);
+    }
+}
+
+/// 把「已入账的增量」折算成软上限后的增量（五维逐维；技能点不动）
+///
+/// 用于赛后奖励这类**结算发生在外部**的通道：先按原值入账，再按赛前值折算回填。
+pub(crate) fn capped_gain(cap: i32, pre: &Array5, gained: &Array5) -> Array5 {
+    let mut out: Array5 = [0; 5];
+    for (slot, (&p, &g)) in pre.iter().zip(gained.iter()).enumerate() {
+        out[slot] = soft_cap_gain(cap, p, g);
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn soft_cap_partial_halving() {
+        // 报文算例：pre=1195 名义 30 → 17；pre=1196 名义 14 → 9；pre=1179 名义 38 → 29
+        assert_eq!(soft_cap_gain(1200, 1195, 30), 17);
+        assert_eq!(soft_cap_gain(1200, 1196, 14), 9);
+        assert_eq!(soft_cap_gain(1200, 1179, 38), 29);
+    }
+
+    #[test]
+    fn soft_cap_above_and_below_cap() {
+        // 赛后奖励算例：pre=1300 名义 7 → 3（cid168 t54 大阪杯 速度）
+        assert_eq!(soft_cap_gain(1200, 1300, 7), 3);
+        // 没过线：全额
+        assert_eq!(soft_cap_gain(1200, 451, 7), 7);
+        assert_eq!(soft_cap_gain(1200, 1193, 7), 7);
+    }
+
+    #[test]
+    fn soft_cap_disabled_returns_gain() {
+        assert_eq!(soft_cap_gain(0, 1300, 7), 7);
+        assert_eq!(soft_cap_gain(-1, 1300, 7), 7);
+        // 无增量 / 负增量不动
+        assert_eq!(soft_cap_gain(1200, 100, 0), 0);
+    }
+
+    #[test]
+    fn apply_soft_cap_keeps_skill_point() {
+        let mut value = ActionValue {
+            status_pt: [10, 0, 0, 0, 0, 30],
+            ..Default::default()
+        };
+        let pre: Array5 = [1200, 0, 0, 0, 0];
+        apply_soft_cap(1200, &pre, &mut value);
+        assert_eq!(value.status_pt[0], 5, "过线的那一维减半");
+        assert_eq!(value.status_pt[5], 30, "技能点不受软上限影响");
+    }
+
+    /// 资产里剧本 15 的阈值就是 1200（`0` = 关闭）
+    ///
+    /// port / rebase 时最容易静默丢掉的就是 JSON 里这一格——字段没接上时引擎不报错，
+    /// 只是压缩整条消失（实测随机档 −80、强策档 −396 的量级）。
+    #[test]
+    fn scenario_asset_declares_the_packet_threshold() {
+        assert_eq!(
+            crate::testing::sample_data().rules.status_soft_cap,
+            1200,
+            "剧本资产 `rules.status_soft_cap` 不是 1200 ⇒ 压缩掉出资产或被改口径"
+        );
+    }
+
+    /// 同种子两臂（压 / 不压）跑一次结算，逐维要求「实得 = 未压增量按 1200 折算」
+    ///
+    /// `pre` 取 1300（已过线）⇒ 每一维都应当恰好是未压增量的一半（向下取整）。
+    /// 换 `cap` 只动资产字段，随机流与剧本策略流都不变 ⇒ 两臂唯一差别就是压缩。
+    fn train_delta(train: usize, keiko: bool, cap: i32) -> Array5 {
+        use rand::SeedableRng;
+        use rand::rngs::StdRng;
+        use std::sync::Arc;
+        use umasim::game::Game;
+
+        let pre_stat: Array5 = [1300; 5];
+        let mut game = crate::testing::sample_game();
+        game.uma_mut().five_status = pre_stat;
+        // 落位照上游内联测试的口径手工摆一位人头（`after_train` 要读 `distribution[train]`）
+        game.base.distribution = vec![vec![0], vec![], vec![], vec![], vec![]];
+        Arc::get_mut(&mut game.data)
+            .expect("sample_game 独占 data，可改写资产")
+            .rules
+            .status_soft_cap = cap;
+        let mut rng = StdRng::seed_from_u64(20261102);
+        let settled = if keiko {
+            game.do_act_train(train, &mut rng)
+        } else {
+            game.do_train(train, &mut rng)
+        };
+        settled.expect("训练结算失败");
+        let after = game.uma().five_status;
+        let mut delta: Array5 = [0; 5];
+        for (slot, (&p, &a)) in pre_stat.iter().zip(after.iter()).enumerate() {
+            delta[slot] = a - p;
+        }
+        delta
+    }
+
+    #[test]
+    fn normal_train_channel_applies_soft_cap() {
+        let uncapped = train_delta(0, false, 0);
+        let capped = train_delta(0, false, 1200);
+        for slot in 0..5 {
+            assert_eq!(
+                capped[slot],
+                soft_cap_gain(1200, 1300, uncapped[slot]),
+                "普通训练第 {slot} 维：压缩没接进 `settle_training` 的入账处"
+            );
+        }
+        assert!(
+            uncapped.iter().sum::<i32>() > 0,
+            "两臂都没增量 ⇒ 这条用例已经失效（训练结算路径变了）"
+        );
+    }
+
+    #[test]
+    fn act_keiko_channel_applies_soft_cap() {
+        let uncapped = train_delta(0, true, 0);
+        let capped = train_delta(0, true, 1200);
+        for slot in 0..5 {
+            assert_eq!(
+                capped[slot],
+                soft_cap_gain(1200, 1300, uncapped[slot]),
+                "演目稽古第 {slot} 维：压缩没接进 `settle_training` 的入账处"
+            );
+        }
+        assert!(
+            uncapped.iter().sum::<i32>() > 0,
+            "两臂都没增量 ⇒ 这条用例已经失效（稽古结算路径变了）"
+        );
+    }
+}
