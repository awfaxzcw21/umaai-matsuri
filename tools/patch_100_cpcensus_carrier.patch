+//! 【#100 测量壳专用，永不并回主仓】整局按**面板建议**打，量発表会档位会不会退化。
+//!
+//! 为什么需要它：#98 删掉的那条兜底只活在 `mccli` 的**候选重排**（建议层）。
+//! `matsuri-dist` 用 `MatsuriRolloutTrainer` 基策跑整局，**根本不经过那段代码**，
+//! 所以「主树门禁 +0.0」对它是恒等式（见 `docs/PT缺口逐源_20261106.md` §24.1）。
+//! 想问「照着面板打，发表会档位会不会变差」，只能让整局的**每一手都取自面板的 top-1**，
+//! 而且必须调 `matsuri_cli::rank` 那份代码——历史上 `_wt_legcell/searcharm.rs` 是
+//! 照着另写一遍估值，那种壳对主树没有约束力。
+//!
+//! 用法：`matsuri-cpcensus <state.json> <out.jsonl> [--arm A|B]`
+//!
+//! 环境变量：
+//!   - `MC_ARM=A` ⇒ 把 #98 删掉那条重排**原样挂回**（＝发布前面板的行为）；
+//!     不设或 `B` ⇒ 不挂（＝现在发布的这个）。**同一颗 exe，只差这一个变量。**
+//!   - `MC_N` 局数、`MC_SEED` 种子基、`MC_K` 2-ply 预算、`MC_PLY`、`MC_FROM_T1=1` 停在开局
+//!   - `MC_TRACE=1` 每手落子序列也写进 jsonl
+//!
+//! 输出（jsonl，一行一局）：`i/seed/cp_log[[schedule,great],..]/five_sum/stat_score/pt/real/
+//! train_decisions/overridden/act_level_at_end`
+
+use std::cell::Cell;
+use std::sync::OnceLock;
+
+use anyhow::{Context, Result};
+use rand::SeedableRng;
+use rand::rngs::StdRng;
+use serde_json::json;
+
+use matsuri_core::game::{Action, MatsuriGame};
+use matsuri_core::trainer::MatsuriRolloutTrainer;
+use umasim::game::{Game, Trainer};
+use umasim::search::FlatSearchGame;
+
+use matsuri_cli::rank;
+use matsuri_cli::state;
+
+const GOLDEN_A: u64 = 0x5DEE_CE66_D1CE_4A1F;
+const GOLDEN_B: u64 = 0xD1B5_4A32_D192_ED03;
+
+/// A 臂＝把删掉的重排挂回去（`MC_ARM=A`）。不设＝B 臂＝发布后的行为。
+fn arm_a() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("MC_ARM").map(|v| v.eq_ignore_ascii_case("A")).unwrap_or(false))
+}
+
+/// 【仪器自检】`MC_POLICY=base` ⇒ 训练决策也交给基策，整局应与 `matsuri-dist` 逐局相同
+/// （同种子散列、同 rng 派生、同三分量算法）。用来证明这台仪器本身的读数口径没跑偏。
+fn base_mode() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("MC_POLICY").map(|v| v == "base").unwrap_or(false))
+}
+
+fn trace_on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("MC_TRACE").map(|v| v == "1").unwrap_or(false))
+}
+
+/// 每个训练决策点做一次与面板**同一段代码**的排序，取 top-1。
+/// 非训练决策点与事件选项全部委托基策 ⇒ 两臂只差在训练落位。
+struct PanelTrainer {
+    search_n: usize,
+    decisions: Cell<usize>,
+    overridden: Cell<usize>,
+    picks: std::cell::RefCell<Vec<String>>,
+}
+
+impl PanelTrainer {
+    fn pick_index(&self, game: &MatsuriGame, actions: &[Action]) -> Result<usize> {
+        let (acts, rows, ..) = rank::panel_rows(game, self.search_n)?;
+        let _ = &acts;
+        let mut rows = rows;
+        let bare = rows.first().map(|r| r.0.clone());
+        if arm_a() {
+            rank::legacy_cp_fallback_reorder(game, &mut rows);
+        }
+        let chosen = rows
+            .first()
+            .context("候选行为空")?
+            .0
+            .clone();
+        self.decisions.set(self.decisions.get() + 1);
+        if Some(chosen.as_str()) != bare.as_deref() {
+            self.overridden.set(self.overridden.get() + 1);
+        }
+        if trace_on() {
+            self.picks.borrow_mut().push(format!("t{}:{chosen}", game.turn));
+        }
+        // 按标签回到 actions 的下标（不假设 list_actions 的次序稳定）
+        actions
+            .iter()
+            .position(|a| rank::label_of(a) == chosen)
+            .with_context(|| format!("面板 top-1「{chosen}」不在本回合动作表里"))
+    }
+}
+
+impl Trainer<MatsuriGame> for PanelTrainer {
+    fn select_action(
+        &self,
+        game: &MatsuriGame,
+        actions: &[Action],
+        rng: &mut StdRng,
+    ) -> Result<usize> {
+        if base_mode() || game.stage().get() != rank::STAGE_TRAIN {
+            return MatsuriRolloutTrainer.select_action(game, actions, rng);
+        }
+        self.pick_index(game, actions)
+    }
+
+    fn select_choice(
+        &self,
+        game: &MatsuriGame,
+        choices: &[Vec<umaai_core::gamedata::EventChoice>],
+        rng: &mut StdRng,
+    ) -> Result<usize> {
+        MatsuriRolloutTrainer.select_choice(game, choices, rng)
+    }
+}
+
+fn revise(v: i32) -> i32 {
+    if v <= 1200 { v } else { 2 * v - 1200 }
+}
+
+/// 与 `dist.rs` 同一行口径（`consts.status_final_score(revise(v))`）；
+/// 一致性由 `tools/cp98_selfcheck.py` 拿基策档对 `matsuri-dist` 核。
+fn gate_triple(g: &MatsuriGame) -> Result<(i32, i32, i32)> {
+    let data = umaai_core::Data::get()?;
+    let consts = &data.consts;
+    let uma = g.uma();
+    let stat = uma
+        .five_status
+        .iter()
+        .map(|&v| consts.status_final_score(revise(v)))
+        .sum();
+    Ok((uma.five_status.iter().sum(), stat, uma.skill_pt))
+}
+
+fn main() {
+    if let Err(e) = run() {
+        eprintln!("错误: {e:#}");
+        std::process::exit(1);
+    }
+}
+
+fn run() -> Result<()> {
+    let args: Vec<String> = std::env::args().collect();
+    let state_path = args.get(1).cloned().unwrap_or("_state_t30.json".into());
+    let out_path = args.get(2).cloned().unwrap_or("out/cp98.jsonl".into());
+    let search_n: usize = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(200);
+    let n: usize = std::env::var("MC_N").ok().and_then(|s| s.parse().ok()).unwrap_or(4);
+    let seed_base: u64 = std::env::var("MC_SEED").ok().and_then(|s| s.parse().ok()).unwrap_or(0);
+    let raw = std::fs::read_to_string(&state_path).context("读状态失败")?;
+
+    let arm = if arm_a() { "A" } else { "B" };
+    let mut lines: Vec<String> = Vec::with_capacity(n);
+    let t0 = std::time::Instant::now();
+    for i in 0..n {
+        let seed = seed_base.wrapping_mul(GOLDEN_A).wrapping_add((i as u64).wrapping_mul(GOLDEN_B));
+        // 每局都重新装配：assemble_game 会改 game 状态，CRN 靠 seed 而不是靠复用局面
+        let loaded = state::assemble_game(&raw)?;
+        let mut g = loaded.game.fork_for_rollout(seed);
+        let trainer = PanelTrainer {
+            search_n,
+            decisions: Cell::new(0),
+            overridden: Cell::new(0),
+            picks: std::cell::RefCell::new(Vec::new()),
+        };
+        let mut rng = StdRng::seed_from_u64(seed ^ 0xA1B2_C3D4_5E6F_7081);
+        g.run_full_game(&trainer, &mut rng)?;
+        let (five_sum, stat_score, pt) = gate_triple(&g)?;
+        let cp_log = g.cp_log.clone();
+        let keiko_probe = g.keiko_probe.clone();
+        let picks: Vec<String> = if trace_on() {
+            std::mem::take(&mut *trainer.picks.borrow_mut())
+        } else {
+            Vec::new()
+        };
+        let overridden = trainer.overridden.get();
+        let decisions = trainer.decisions.get();
+        let rec = json!({
+            "arm": arm,
+            "policy": if base_mode() { "base" } else { "panel" },
+            "i": i,
+            "seed": seed,
+            "from_t1": std::env::var("MC_FROM_T1").map(|v| v == "1").unwrap_or(false),
+            "cp_log": cp_log,
+            "keiko_probe": keiko_probe,
+            "five_sum": five_sum,
+            "stat_score": stat_score,
+            "pt": pt,
+            "train_decisions": decisions,
+            "overridden": overridden,
+            "act_level": g.act_level,
+            "act_gauge": g.act_gauge,
+            "picks": picks,
+        });
+        lines.push(serde_json::to_string(&rec)?);
+        eprintln!(
+            "[{arm}] 局 {}/{} seed={seed} cp={:?} 五维和={five_sum} 五维分={stat_score} PT={pt} 兜底改写={} / 训练决策={}",
+            i + 1,
+            n,
+            cp_log,
+            overridden,
+            decisions,
+        );
+    }
+    if let Some(dir) = std::path::Path::new(&out_path).parent() {
+        let _ = std::fs::create_dir_all(dir);
+    }
+    std::fs::write(&out_path, lines.join("\n") + "\n").context("写 jsonl 失败")?;
+    eprintln!(
+        "[{arm}] 完成 {} 局，用时 {:.1}s（{:.1}s/局）→ {out_path}",
+        n,
+        t0.elapsed().as_secs_f64(),
+        t0.elapsed().as_secs_f64() / n.max(1) as f64
+    );
+    Ok(())
+}
