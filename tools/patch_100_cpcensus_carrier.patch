diff --git a/kill_stray.ps1 b/kill_stray.ps1
new file mode 100644
index 0000000..f30cd3d
--- /dev/null
+++ b/kill_stray.ps1
@@ -0,0 +1,35 @@
+# Kill ONLY the accidentally launched batch (cpcensus writing out/cp98/run_[AB]_*).
+# Never touches the t1K1024 jobs, never touches wait_K1024.sh.
+$ErrorActionPreference = 'SilentlyContinue'
+
+$procs = @(Get-CimInstance Win32_Process -Filter "name='matsuri-cpcensus.exe'")
+$keep = @(); $kill = @()
+foreach ($p in $procs) {
+    $c = $p.CommandLine
+    if ($null -ne $c -and $c -match 't1K1024') { $keep += $p }
+    elseif ($null -ne $c -and $c -match 'run_[AB]_') { $kill += $p }
+    else { $kill += $p }
+}
+Write-Output ("total cpcensus = {0}  keep(t1K1024) = {1}  kill = {2}" -f $procs.Count, $keep.Count, $kill.Count)
+
+# first stop the spawner so no new jobs are launched
+$spawn = @(Get-CimInstance Win32_Process -Filter "name='bash.exe'" |
+    Where-Object { $_.CommandLine -match 'run_cp98\.sh' -and $_.CommandLine -match 'check' })
+foreach ($s in $spawn) {
+    Write-Output ("kill spawner PID {0}" -f $s.ProcessId)
+    Stop-Process -Id $s.ProcessId -Force
+}
+
+foreach ($p in $kill) {
+    Write-Output ("kill worker PID {0}" -f $p.ProcessId)
+    Stop-Process -Id $p.ProcessId -Force
+}
+
+Start-Sleep -Seconds 3
+$left = @(Get-CimInstance Win32_Process -Filter "name='matsuri-cpcensus.exe'")
+Write-Output ("after kill: {0} processes left" -f $left.Count)
+foreach ($p in $left) {
+    $c = $p.CommandLine
+    $tag = if ($null -ne $c -and $c -match 't1K1024') { 'K1024-OK' } elseif ($null -ne $c -and $c -match 'run_[AB]_') { 'STILL-STRAY' } else { 'UNKNOWN' }
+    Write-Output ("  PID {0} {1}" -f $p.ProcessId, $tag)
+}
diff --git a/run_cp98.sh b/run_cp98.sh
new file mode 100644
index 0000000..85ae903
--- /dev/null
+++ b/run_cp98.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# #100 主树侧大成功率复核：整局按面板建议打，A=挂回 #98 删掉的重排，B=不挂（＝现在发布的）。
+# 同一颗 exe，只差 MC_ARM 一个环境变量。
+#   用法：bash run_cp98.sh <K> <FROM_T1> <shards> <n_per_shard> <tag> [jobs]
+#   例：  bash run_cp98.sh 32 1 16 12 t1K32
+set -u
+cd "$(dirname "$0")"
+K=${1:-32}
+T1=${2:-1}
+SHARDS=${3:-16}
+NPER=${4:-12}
+TAG=${5:-run}
+JOBS=${6:-14}
+STATE=${STATE:-E:/HJM/umaai-matsuri/_state_t30.json}
+EXE=${EXE:-./target/release/matsuri-cpcensus.exe}
+OUT=out/cp98
+mkdir -p "$OUT"
+rm -f "$OUT/${TAG}"_*.jsonl "$OUT/${TAG}"_*.log
+
+echo "== $TAG: K=$K FROM_T1=$T1 shards=$SHARDS n/片=$NPER 并发=$JOBS =="
+echo "   exe sha $(sha1sum "$EXE" | cut -c1-12)  state=$STATE"
+t0=$(date +%s)
+for s in $(seq 1 "$SHARDS"); do
+  for arm in A B; do
+    while [ "$(jobs -rp | wc -l)" -ge "$JOBS" ]; do wait -n; done
+    MC_ARM=$arm MC_FROM_T1=$T1 MC_K=$K MC_PLY=2 MC_SEED=$s MC_N=$NPER \
+      "$EXE" "$STATE" "$OUT/${TAG}_${arm}_s${s}.jsonl" 200 \
+      > "$OUT/${TAG}_${arm}_s${s}.log" 2>&1 &
+  done
+done
+wait
+n=$(cat "$OUT/${TAG}"_*.jsonl | grep -c .)
+echo "== $TAG 完：$n 局，墙钟 $(( $(date +%s) - t0 ))s =="
diff --git a/wait_K1024.sh b/wait_K1024.sh
new file mode 100644
index 0000000..fad25f4
--- /dev/null
+++ b/wait_K1024.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# #100 K=1024 收尾守望：等 24 片全落地，然后出「档位配对 McNemar ＋ 三分量配对差 ＋ 仪器读数」。
+# 结果同时写 out/cp98/K1024_result.txt（含时间戳），本脚本自身的 stdout 只报进度。
+set -u
+cd "$(dirname "$0")"
+OUT=out/cp98
+RES=$OUT/K1024_result.txt
+T0=$(date +%s)
+while :; do
+  n=$(ls "$OUT"/t1K1024_*.jsonl 2>/dev/null | wc -l)
+  g=$(grep -ho '局 [0-9]*/4' "$OUT"/t1K1024_*.log 2>/dev/null | awk -F'[ /]' '{s+=$2} END{print s+0}')
+  if [ "$n" -ge 24 ]; then
+    echo "[$(( ($(date +%s)-T0)/60 )) 分] 24 片齐，开始出读数"
+    break
+  fi
+  if [ $(( $(date +%s) - T0 )) -gt 9000 ]; then
+    echo "[$(( ($(date +%s)-T0)/60 )) 分] 超时保护：只有 $n/24 片（局 $g/96），用现有片出读数"
+    break
+  fi
+  sleep 60
+done
+
+A="$OUT/t1K1024_A_s*.jsonl"
+B="$OUT/t1K1024_B_s*.jsonl"
+MT=/e/HJM/umaai-matsuri/tools/cp98_tiers.py
+MI=/e/HJM/umaai-matsuri/tools/cp98_instrument.py
+{
+  echo "# #100 K=1024（面板真实预算）双臂读数 — $(date -Is)"
+  echo
+  echo "## 三分量 ＋ 逐场大成功率"
+  python "$MT" --a "$A" --b "$B" --tag "K=1024 面板真实预算（整局按面板建议打）"
+  echo
+  echo "## 仪器（确定性／CRN 用料／A 臂剂量／B 臂终值）"
+  python "$MI" --a "$A" --b "$B" --workdir "E:/HJM/_wt_cp98"
+} > "$RES" 2>&1
+echo "读数已写入 $RES"
+tail -n 40 "$RES"
