+/// `pt_mult` / `friend_mult` 是引擎自己的乘区读数，用来判断「少掉的一半」落在
+/// 基础值还是乘区；`pt_over_five` 是与真机板上报文可比的**比值判据**（乘区在比值里约掉）。
+fn train_legs_mean(sum: &[[[[i64; 16]; 8]; 6]; 2], n_runs: usize) -> Value {
+    let m = n_runs.max(1) as f64;
+    let slot_names = ["plain", "keiko_home"];
+    let mut per_cell: Vec<Value> = Vec::new();
+    let mut totals = [0i64; 2];
+    let mut oob = [0i64; 2];
+    for (s, slots) in sum.iter().enumerate() {
+        for (lv, rows) in slots.iter().enumerate() {
+            for (heads, c) in rows.iter().enumerate() {
+                if c[0] == 0 {
+                    continue;
+                }
+                totals[s] += c[0];
+                if lv == 0 || heads == 7 {
+                    oob[s] += c[0];
+                }
+                let d = c[0] as f64;
+                per_cell.push(json!({
+                    "slot": slot_names[s],
+                    "lv": lv,
+                    "heads": heads,
+                    "hands": c[0],
+                    "hands_per_run": c[0] as f64 / m,
+                    "pt": c[1] as f64 / d,
+                    "base_pt": c[2] as f64 / d,
+                    "five": c[3] as f64 / d,
+                    "vital": c[4] as f64 / d,
+                    "pt_mult": c[5] as f64 / 1000.0 / d,
+                    "friend_mult": c[6] as f64 / 1000.0 / d,
+                    "effect_pct": c[7] as f64 / 10.0 / d,
+                    "friend_pct": c[8] as f64 / 10.0 / d,
+                    "shining_hand_share": c[9] as f64 / d,
+                    "shining_heads": c[10] as f64 / d,
+                    "heads_total": c[11] as f64 / d,
+                    "h_card": c[12] as f64 / d,
+                    "h_team": c[13] as f64 / d,
+                    "h_npc": c[14] as f64 / d,
+                    "h_other": c[15] as f64 / d,
+                    "pt_over_five": c[1] as f64 / c[3].max(1) as f64,
+                }));
+            }
+        }
+    }
+    json!({
+        "columns": train_legs::COLS,
+        "hands_total": { "plain": totals[0], "keiko_home": totals[1] },
+        "hands_per_run": { "plain": totals[0] as f64 / m, "keiko_home": totals[1] as f64 / m },
+        "oob": { "plain": oob[0], "keiko_home": oob[1] },
+        "per_cell": per_cell,
+    })
+}
+/// 稽古分腿（#39）：按演目 Lv 出每手均值，分母 = 该 Lv 的**成功手**（失败手不发收益）。
+/// `oob` 是落在 Lv 钳位之外的手数，正常应为 0。
+fn keiko_legs_mean(sum: &[[i64; 7]], n_runs: usize) -> Value {
+    let m = n_runs.max(1) as f64;
+    let per_lv: Vec<Value> = (1..=10u64)
+        .map(|lv| {
+            let r = sum[lv as usize];
+            let ok = (r[0] - r[1]).max(0) as f64;
+            let d = if ok > 0.0 { ok } else { 1.0 };
+            json!({
+                "lv": lv,
+                "hands_per_run": r[0] as f64 / m,
+                "failed_per_run": r[1] as f64 / m,
+                "ok_hands_per_run": ok / m,
+                "home_leg_pt": r[2] as f64 / d,
+                "act_leg_pt": r[3] as f64 / d,
+                "home_leg_five": r[4] as f64 / d,
+                "act_leg_five": r[5] as f64 / d,
+                "act_share_of_pt": r[3] as f64 / (r[2] + r[3]).max(1) as f64,
+                "extra_keiko_per_run": r[6] as f64 / m,
+            })
+        })
+        .collect();
+    json!({
+        "columns": keiko_legs::LEG_COLS,
+        "per_lv": per_lv,
+        "oob": { "lv0": sum[0][0], "lv11": sum[keiko_legs::LV_N - 1][0] },
+    })
+}
