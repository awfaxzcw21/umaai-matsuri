@@ -0,0 +1,169 @@
+//! 训练腿分解打点（**测量壳专用，不并回 HEAD**）
+//!
+//! #40 要回答的是「引擎训练腿 PT 只有真机一半，丢在哪个乘区」，所以这里不只要 PT 的总数，
+//! 而是把 `training_leg` 的**分解**记下来：基础值 `base_pt` → 教诲/训练效果乘区 `pt_mult`
+//! → 彩圈+友情乘区 `friend_mult`，再按 (训练Lv, **支援卡人头**) 分桶。
+//!
+//! 分桶键只数 `PersonType::Card`，不是数全部人头：板上报文 `training_partner_array` 里
+//! `<100` 的那些就是卡组位，`>=100` 的是剧本成员/NPC/记者/理事长，而引擎的
+//! `base.distribution` 把**所有** person 类型都装进去（`gain_act_gauge_from_train` 那段
+//! 明确写了记者/理事长/友人不算担当）。两侧只有按「支援卡人头」对齐才是同一个变量。
+//!
+//! 真机侧同位置可比量 = 板上报文 `home_info` 的 `target_type=30`
+//! （`tools/train_leg_preview.py`）。关键判据是 **Pt/Σ五维 比值**：引擎里 PT 与五维共用
+//! `pt_mult`/`friend_mult`，比值对人头应近似不变；真机比值却随人头从 0.47 涨到 1.0
+//! ⇒ 结构性差异，不是系数大小。
+
+use std::cell::RefCell;
+
+pub const LV_N: usize = 6; // 下标 1..=5（训练 Lv）
+pub const CARD_N: usize = 8; // 0..=7（支援卡人头）
+
+/// 一格：`[hands, pt_sum, base_pt_sum, five_sum, vital_sum, pt_mult_x1000, friend_x1000,
+///        effect_pct_x10, friend_pct_x10, shining_hands, shining_heads_sum,
+///        heads_total_sum, h_card_sum, h_team_sum, h_npc_sum, h_other_sum]`
+pub type Cell = [i64; 16];
+
+pub const COLS: [&str; 16] = [
+    "hands",
+    "pt_sum",
+    "base_pt_sum",
+    "five_sum",
+    "vital_sum",
+    "pt_mult_x1000",
+    "friend_x1000",
+    "effect_pct_x10",
+    "friend_pct_x10",
+    "shining_hands",
+    "shining_heads_sum",
+    "heads_total_sum",
+    "h_card_sum",
+    "h_team_sum",
+    "h_npc_sum",
+    "h_other_sum",
+];
+
+#[derive(Debug, Clone, Copy)]
+pub struct LegObs {
+    pub lv: usize,
+    pub card_heads: usize,
+    pub heads_total: i64,
+    pub h_card: i64,
+    pub h_team: i64,
+    pub h_npc: i64,
+    pub h_other: i64,
+    pub shining_heads: usize,
+    pub pt: i64,
+    pub base_pt: i64,
+    pub five: i64,
+    pub vital: i64,
+    pub pt_mult: f64,
+    pub friend_mult: f64,
+    pub effect_pct: f64,
+    pub friend_pct: f64,
+}
+
+thread_local! {
+    // 第 0 层 = 普通训练结算，第 1 层 = 稽古的 home 腿
+    static TABLE: RefCell<[[[Cell; CARD_N]; LV_N]; 2]> =
+        const { RefCell::new([[[[0i64; 16]; 8]; 6]; 2]) };
+}
+
+fn bump(slot: usize, o: &LegObs) {
+    let l = o.lv.clamp(0, LV_N - 1);
+    let h = o.card_heads.clamp(0, CARD_N - 1);
+    TABLE.with(|t| {
+        let c = &mut t.borrow_mut()[slot][l][h];
+        c[0] += 1;
+        c[1] += o.pt;
+        c[2] += o.base_pt;
+        c[3] += o.five;
+        c[4] += o.vital;
+        c[5] += (o.pt_mult * 1000.0) as i64;
+        c[6] += (o.friend_mult * 1000.0) as i64;
+        c[7] += (o.effect_pct * 10.0) as i64;
+        c[8] += (o.friend_pct * 10.0) as i64;
+        c[9] += if o.shining_heads > 0 { 1 } else { 0 };
+        c[10] += o.shining_heads as i64;
+        c[11] += o.heads_total;
+        c[12] += o.h_card;
+        c[13] += o.h_team;
+        c[14] += o.h_npc;
+        c[15] += o.h_other;
+    });
+}
+
+/// 普通训练那一条（`do_train` 成功结算处）
+pub fn record_train(o: &LegObs) {
+    bump(0, o);
+}
+
+/// 稽古的 home 腿（`do_keiko_impl` 里 `self.training_leg(idx)` 那一份）
+pub fn record_keiko_home(o: &LegObs) {
+    bump(1, o);
+}
+
+pub fn reset() {
+    TABLE.with(|t| *t.borrow_mut() = [[[[0i64; 16]; 8]; 6]; 2]);
+    BOARD.with(|b| *b.borrow_mut() = [[0i64; 20]; 2]);
+}
+
+pub fn get() -> [[[Cell; CARD_N]; LV_N]; 2] {
+    TABLE.with(|t| *t.borrow())
+}
+
+// ── 盘面打点：一手决策前，5 个训练位上各站了几个**支援卡**人头 ────────────────────
+//
+// 要回答的是 #40 的归属问题：`人头分布效应 −985 Pt/局` 到底是
+// **站位模型**没把卡组堆到一起（盘面就没这种格），还是堆得出而**选位策略**不去站。
+// 真机侧同口径已有（`out/train_leg_preview_20261103.csv` 每块板的每个位）：
+// 真机盘面 98% 的手都有 ≥2 卡的格可站，且 80.6% 的手选中了盘面人头最多的那一格。
+
+/// `[boards, max_hist0..max_hist7, sum_slot_heads, chosen_n, chosen_hist0..chosen_hist7, take_max]`
+pub const BOARD_COLS: [&str; 20] = [
+    "boards",
+    "max0", "max1", "max2", "max3", "max4", "max5", "max6", "max7",
+    "sum_slot_heads",
+    "chosen_n",
+    "ch0", "ch1", "ch2", "ch3", "ch4", "ch5", "ch6", "ch7",
+    "take_max",
+];
+
+pub struct BoardObs {
+    /// 每个训练位上的支援卡人头数（长度 5）
+    pub slot_heads: [i64; 5],
+    /// 选中的槽位；`usize::MAX` = 这手不是训练/稽古
+    pub chosen: usize,
+    pub camp: bool,
+}
+
+thread_local! {
+    // 第 0 层 = 非合宿回合，第 1 层 = 合宿回合（稽古）
+    static BOARD: RefCell<[[i64; 20]; 2]> = const { RefCell::new([[0i64; 20]; 2]) };
+}
+
+pub fn record_board(o: &BoardObs) {
+    let mx = o.slot_heads.iter().max().copied().unwrap_or(0);
+    let l = usize::from(o.camp);
+    BOARD.with(|b| {
+        let r = &mut b.borrow_mut()[l];
+        r[0] += 1;
+        r[1 + mx.clamp(0, 7) as usize] += 1;
+        for h in o.slot_heads {
+            r[9] += h.clamp(0, 7);
+        }
+        if o.chosen != usize::MAX {
+            if let Some(h) = o.slot_heads.get(o.chosen).copied() {
+                r[10] += 1;
+                r[11 + h.clamp(0, 7) as usize] += 1;
+                if h == mx {
+                    r[19] += 1;
+                }
+            }
+        }
+    });
+}
+
+pub fn board_get() -> [[i64; 20]; 2] {
+    BOARD.with(|b| *b.borrow())
+}
