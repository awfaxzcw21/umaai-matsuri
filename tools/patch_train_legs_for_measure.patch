+fn train_board_mean(sum: &[[i64; 20]; 2], n_runs: usize) -> Value {
+    let m = n_runs.max(1) as f64;
+    let names = ["non_camp", "camp"];
+    let per_layer: Vec<Value> = sum
+        .iter()
+        .enumerate()
+        .map(|(l, r)| {
+            let boards = r[0] as f64;
+            let chosen_n = r[10] as f64;
+            json!({
+                "layer": names[l],
+                "decisions_per_run": boards / m,
+                "train_decisions_per_run": chosen_n / m,
+                "max_hist_per_run": (0..8).map(|h| r[1 + h] as f64 / m).collect::<Vec<_>>(),
+                "chosen_hist_per_run": (0..8).map(|h| r[11 + h] as f64 / m).collect::<Vec<_>>(),
+                "mean_slot_heads": r[9] as f64 / (boards * 5.0).max(1.0),
+                "take_max_share": r[19] as f64 / chosen_n.max(1.0),
+                "offer_ge2_share": (r[3] + r[4] + r[5] + r[6] + r[7] + r[8]) as f64 / boards.max(1.0),
+                "chosen_ge2_share": (r[13] + r[14] + r[15] + r[16] + r[17] + r[18]) as f64 / chosen_n.max(1.0),
+            })
+        })
+        .collect();
+    json!({ "columns": train_legs::BOARD_COLS, "per_layer": per_layer })
+}
