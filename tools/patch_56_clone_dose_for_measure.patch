@@ -0,0 +1,193 @@
+//! 逐格残差实验 bin `matsuri-board`（#56 分身定价）
+//!
+//! 一块报文决策板 × 一档分身剂量 → 每个训练位一行 TSV：**引擎自己的训练预告**
+//! 对**面板自报的 `stat_gains`**。分身剂量只通过 `calc_training_buff` 进预告，
+//! 所以「换一档 ⇒ 该格残差动多少」＝ 那一档给分身定的价。不引入任何新常数。
+//!
+//! 用法（仓根跑，`data/` 按当前目录解析）：
+//!   matsuri-board --dose heads_only   out/clone_states/*.json > out/board_headsonly.tsv
+//!   matsuri-board --dose card_effects out/clone_states/*.json > out/board_cardeffects.tsv
+//!   matsuri-board --dose card_effects_friendship out/clone_states/*.json > out/board_friendship.tsv
+//!
+//! 判读在 `tools/clone_dose_did.py`（同板内分身格 vs 非分身格的双差分）。
+//! 退出码：0 正常；2 参数或状态文件不合法。
+
+use std::process::ExitCode;
+
+use anyhow::Result;
+use matsuri_core::game::CloneDose;
+use umasim::game::Game;
+
+use matsuri_cli::state;
+
+/// 面板训练名 → 引擎下标（与 `state.rs` 同一套）
+const TRAINS: [&str; 5] = ["速度", "耐力", "力量", "根性", "智力"];
+
+fn parse_dose(s: &str) -> Option<CloneDose> {
+    Some(match s {
+        "heads_only" => CloneDose::HeadsOnly,
+        "card_effects" => CloneDose::CardEffects,
+        "card_effects_friendship" => CloneDose::CardEffectsFriendship,
+        _ => return None,
+    })
+}
+
+/// TSV 里用的稳定列值（不要用 `Debug`，重命名枚举会变列内容）
+fn dose_tag(d: CloneDose) -> &'static str {
+    match d {
+        CloneDose::HeadsOnly => "heads_only",
+        CloneDose::CardEffects => "card_effects",
+        CloneDose::CardEffectsFriendship => "card_effects_friendship",
+    }
+}
+
+fn run(dose: CloneDose, paths: &[String]) -> Result<()> {
+    println!(
+        "dose\tboard\tturn\tcell\ttrain\tcid\tkind\theads\tclone_slots\tclone_cards\t\
+         eng0\teng1\teng2\teng3\teng4\tengPt\tengVital\t\
+         pkt0\tpkt1\tpkt2\tpkt3\tpkt4\tpktPt\tpktVital\tfailRate\tlevel\tgauge"
+    );
+    for path in paths {
+        let raw = match std::fs::read_to_string(path) {
+            Ok(r) => r,
+            Err(e) => {
+                eprintln!("跳过 {path}：读不到（{e}）");
+                continue;
+            }
+        };
+        let v: serde_json::Value = match serde_json::from_str(&raw) {
+            Ok(v) => v,
+            Err(e) => {
+                eprintln!("跳过 {path}：解析失败（{e}）");
+                continue;
+            }
+        };
+        let loaded = match state::assemble_game(&raw) {
+            Ok(l) => l,
+            Err(e) => {
+                eprintln!("跳过 {path}：装配失败（{e}）");
+                continue;
+            }
+        };
+        if loaded.deck_fallback {
+            eprintln!("跳过 {path}：卡组走了兜底，报文人头无可比性");
+            continue;
+        }
+        let mut game = loaded.game;
+        game.clone_dose = dose;
+        let board = path.rsplit(['/', '\\']).next().unwrap_or(path).to_string();
+        let turn = loaded.panel_turn;
+
+        // 报文侧：同一格可能同时有普通行（101..）与稽古行（5101..），只取普通行做残差
+        let cmds = v
+            .get("commands")
+            .and_then(|x| x.as_array())
+            .cloned()
+            .unwrap_or_default();
+        for t in 0..5 {
+            let Some(cmd) = cmds.iter().find(|c| {
+                c.get("train").and_then(|x| x.as_str()) == Some(TRAINS[t])
+                    && !c.get("is_keiko").and_then(|x| x.as_bool()).unwrap_or(false)
+            }) else {
+                continue;
+            };
+            let cid = cmd.get("command_id").and_then(|x| x.as_i64()).unwrap_or(0);
+            let gains = cmd.get("stat_gains").and_then(|x| x.as_object());
+            let gain = |name: &str| -> i64 {
+                gains
+                    .and_then(|g| g.get(name))
+                    .and_then(|x| x.as_i64())
+                    .unwrap_or(-1)
+            };
+            let (five, pt, vital) = game.train_preview(t);
+            let clones = &game.clone_marks[t];
+            let clone_cards: Vec<String> = clones
+                .iter()
+                .map(|&i| {
+                    let i = i as usize;
+                    match game.deck().get(i) {
+                        Some(c) => format!("{}:{}", i + 1, c.card_id),
+                        None => format!("{i}"),
+                    }
+                })
+                .collect();
+            let level = game.train_level(t);
+            let gauge = game.act_gauge[t];
+            let fail_rate = cmd.get("failure_rate").and_then(|x| x.as_i64()).unwrap_or(0);
+            println!(
+                "{}\t{}\t{}\t{}\t{}\t{}\tplain\t{}\t{}\t{}\t\
+                 {}\t{}\t{}\t{}\t{}\t{}\t{}\t\
+                 {}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}",
+                dose_tag(dose),
+                board,
+                turn,
+                t,
+                TRAINS[t],
+                cid,
+                game.count_training_persons(t),
+                clones.len(),
+                if clone_cards.is_empty() { "-".to_string() } else { clone_cards.join("|") },
+                five[0],
+                five[1],
+                five[2],
+                five[3],
+                five[4],
+                pt,
+                vital,
+                gain("速度"),
+                gain("耐力"),
+                gain("力量"),
+                gain("根性"),
+                gain("智力"),
+                cmd.get("skill_point").and_then(|x| x.as_i64()).unwrap_or(-1),
+                cmd.get("vital_delta").and_then(|x| x.as_i64()).unwrap_or(-9999),
+                fail_rate,
+                level,
+                gauge,
+            );
+        }
+    }
+    Ok(())
+}
+
+fn main() -> ExitCode {
+    let mut dose: Option<CloneDose> = None;
+    let mut paths: Vec<String> = Vec::new();
+    let mut args = std::env::args().skip(1);
+    while let Some(a) = args.next() {
+        if let Some(v) = a.strip_prefix("--dose=") {
+            match parse_dose(v) {
+                Some(d) => dose = Some(d),
+                None => return bad(&format!("不认识的分身剂量：{v}")),
+            }
+        } else if a == "--dose" {
+            let Some(v) = args.next() else {
+                return bad("缺 --dose 的值");
+            };
+            match parse_dose(&v) {
+                Some(d) => dose = Some(d),
+                None => return bad(&format!("不认识的分身剂量：{v}")),
+            }
+        } else {
+            paths.push(a);
+        }
+    }
+    let Some(dose) = dose else {
+        return bad("用法：matsuri-board --dose <heads_only|card_effects|card_effects_friendship> <state.json ...>");
+    };
+    if paths.is_empty() {
+        return bad("没有状态文件");
+    }
+    match run(dose, &paths) {
+        Ok(()) => ExitCode::SUCCESS,
+        Err(e) => {
+            eprintln!("失败：{e}");
+            ExitCode::from(1)
+        }
+    }
+}
+
+fn bad(msg: &str) -> ExitCode {
+    eprintln!("{msg}");
+    ExitCode::from(2)
+}
