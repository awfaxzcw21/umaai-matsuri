+    /// `calc_training_buff_without_clones_matches_default`）。
+    fn calc_training_buff(&self, train: usize) -> Result<CardTrainingEffect> {
+        let marks = match self.clone_marks.get(train) {
+            Some(m) if !m.is_empty() => m,
+            _ => return self.default_calc_training_buff(train),
+        };
+        let mut ret = CardTrainingEffect::default();
+        let Some(indices) = self.distribution().get(train) else {
+            return Ok(ret);
+        };
+        for &index in indices {
+            // 负数为分身占位或空位（与上游同一哨兵口径）
+            if index < 0 {
+                continue;
+            }
+            let person_index = index as usize;
+            // 布局契约：卡片人头占 persons 前缀，前缀之外（理事长/记者/嘉宾/NPC）不贡献卡加成
+            if person_index >= self.deck().len() {
+                continue;
+            }
+            let mut effect = self.deck()[person_index].calc_training_effect(self, train as i32);
+            if marks.contains(&index) {
+                match self.clone_dose {
+                    // 只算人头：词条整条丢掉（人头加成走 `count_training_persons`，不在这里）
+                    CloneDose::HeadsOnly => effect = CardTrainingEffect::default(),
+                    // ＝现行为：吃词条、友情归零
+                    CloneDose::CardEffects => effect.youqing = 0.0,
+                    // 视作本格彩圈：连友情一起吃
+                    CloneDose::CardEffectsFriendship => {}
+                }
+            } else if !self.is_shining_at(person_index, train) {
+                effect.youqing = 0.0;
+            }
+            ret = ret.add(&effect);
+        }
+        Ok(ret)
+    }
