@@ -0,0 +1,77 @@
+//! 逐源增益台账（**测量壳专用，不并回 HEAD**）
+//!
+//! 目的：把一局里 PT / 五维的毛增按来源分桶，与 `docs/PT台账_20261103.md` 的真机逐源
+//! 账本对齐，定位「引擎比真机少的那 1,805 PT / 7,053 五维分」缺在哪一源。
+//!
+//! 口径与真机侧一致：**只记正差分**（毛增），负向（掉属性 / 技能购入）不计入；
+//! 状态用 `thread_local` 而不进 `MatsuriGame`，避免污染序列化与 `fork_for_rollout`。
+
+use std::cell::RefCell;
+
+pub const SRC_TRAIN: usize = 0;
+pub const SRC_KEIKO: usize = 1;
+pub const SRC_RACE_TARGET: usize = 2;
+pub const SRC_RACE_FREE: usize = 3;
+pub const SRC_CHECK_POINT: usize = 4;
+pub const SRC_EVENT: usize = 5;
+pub const SRC_N: usize = 6;
+
+/// 与真机账本对齐用的桶名（顺序同 `SRC_*`）
+pub const SRC_NAMES: [&str; SRC_N] = [
+    "train",
+    "keiko",
+    "race_target",
+    "race_free",
+    "check_point",
+    "event",
+];
+
+/// 一列 = `[pt, 速, 耐, 力, 根, 智, 结算次数]`
+pub type Acc = [i64; 7];  // 末列 = 结算次数
+
+#[derive(Debug, Clone, Copy)]
+pub struct Snap {
+    pub pt: i64,
+    pub five: [i64; 5],
+}
+
+thread_local! {
+    static LEDGER: RefCell<[Acc; SRC_N]> = const { RefCell::new([[0i64; 7]; SRC_N]) };
+}
+
+/// 从马娘当前状态取快照（调用方负责在结算前后各取一次）
+pub fn snap(pt: i32, five: [i32; 5]) -> Snap {
+    Snap {
+        pt: pt as i64,
+        five: five.map(i64::from),
+    }
+}
+
+/// 累加一次结算的正差分
+pub fn accrue(src: usize, before: Snap, after: Snap) {
+    LEDGER.with(|l| {
+        let mut l = l.borrow_mut();
+        let row = &mut l[src];
+        let d = after.pt - before.pt;
+        if d > 0 {
+            row[0] += d;
+        }
+        for i in 0..5 {
+            let d = after.five[i] - before.five[i];
+            if d > 0 {
+                row[1 + i] += d;
+            }
+        }
+        row[6] += 1;
+    });
+}
+
+/// 清零（每局开跑前）
+pub fn reset() {
+    LEDGER.with(|l| *l.borrow_mut() = [[0i64; 7]; SRC_N]);
+}
+
+/// 读出累计值（顺序同 [`SRC_NAMES`]）
+pub fn get() -> [Acc; SRC_N] {
+    LEDGER.with(|l| *l.borrow())
+}
