+++ b/crates/matsuri-cli/src/searcharm.rs
@@ -0,0 +1,257 @@
+//! #41 强策档臂（**测量壳专用，不并回 HEAD**）
+//!
+//! 把面板那一层的决策者（`matsuri-mccli` 的 2-ply 搜索）当成**整局的策略**来跑：
+//! 每个训练决策点做一次与 mccli 同口径的搜索，argmax 就是这手落的动作。
+//!
+//! 要回答的是 #40 留下那句警告：基策臂量到「选位增益 0.56×」（引擎只取到盘面最满格的 56%，
+//! 真机玩家 95%）。这 0.56 到底是
+//!   · **策略没学** —— 盘面上有满格，估值看得见人头，换成强策档就会去站；
+//!   · **盘面给不出** —— 强策档也不站，说明估值里根本没有人头这一项，得先补机制。
+//! 只能用强策档重跑一遍才知道。代码侧的先验：`MatsuriRolloutTrainer::desired` 五条规则
+//! 没有一条看人头 ⇒ 基策的 take 期望就等于随机，与 #40 读到的 1.058 == `mean_slot_heads` 吻合。
+//!
+//! 打点纪律：搜索内部的推演**不进表**（`train_legs::set_record(false)`），
+//! 只有根决策 + 它自己的结算进 ⇒ `train_board` / `train_legs` / `keiko_legs` 三张表
+//! 都是「强策档这一局」的口径，可以直接喂 `tools/train_leg_gap_split.py`。
+
+use std::cell::Cell;
+
+use anyhow::Result;
+use rand::SeedableRng;
+use rand::rngs::StdRng;
+
+use matsuri_core::game::train_legs;
+use matsuri_core::game::{Action, MatsuriGame};
+use matsuri_core::trainer::MatsuriRolloutTrainer;
+use umasim::game::{Game, Trainer};
+use umasim::search::FlatSearchGame;
+
+/// 剧本阶段机里训练决策点的编号（与 `matsuri-core/src/game/stage.rs` 的 Begin=0/Train=1/End=2 对齐）
+const STAGE_TRAIN: u64 = 1;
+
+const GOLDEN_A: u64 = 0x9E37_79B9_7F4A_7C15;
+const GOLDEN_B: u64 = 0xD1B5_4A32_D192_ED03;
+
+fn mix(seed: u64, k: usize) -> u64 {
+    seed.wrapping_mul(GOLDEN_A).wrapping_add(k as u64 * GOLDEN_B)
+}
+
+/// 从当前 Train 阶段推进到**下一个** Train 阶段（与 `mccli::to_next_train` 逐字同构）
+fn to_next_train(g: &mut MatsuriGame, seed: u64) -> Result<bool> {
+    while g.next() {
+        if g.stage().get() == STAGE_TRAIN {
+            return Ok(true);
+        }
+        let mut rr = StdRng::seed_from_u64(seed ^ 0x51ED_2701_9E37_79B9);
+        g.run_stage(&MatsuriRolloutTrainer, &mut rr)?;
+    }
+    Ok(false)
+}
+
+/// 把整局推到底（playout 用基策，与 mccli 的子节点同一条 rollout）
+fn play_out(mut g: MatsuriGame, seed: u64) -> Result<f64> {
+    while g.next() {
+        let mut rr = StdRng::seed_from_u64(seed ^ 0x51ED_2701_9E37_79B9);
+        g.run_stage(&MatsuriRolloutTrainer, &mut rr)?;
+    }
+    g.search_score(1.0)
+}
+
+/// 一个根动作的估值：有下一步训练 ⇒ 2-ply（子动作 CRN 配对，取「下一步也选对」的可达值）；
+/// 没有 ⇒ 退回单步（与面板终局分支同口径）。第二个返回值 = 这手走了单步分支。
+fn root_value(game: &MatsuriGame, a: &Action, k: usize, seed: u64) -> Result<(f64, bool)> {
+    let mut probe = game.fork_for_rollout(seed ^ 0x5555_0001_0000);
+    let mut pr = StdRng::seed_from_u64(seed ^ 0x1234_5678_9ABC_DEF0);
+    probe.apply_root_action(a, &mut pr)?;
+    if !to_next_train(&mut probe, seed)? {
+        let mut sum = 0.0f64;
+        for ki in 0..k {
+            let s = mix(seed, ki);
+            let mut g = game.fork_for_rollout(s);
+            let mut r = StdRng::seed_from_u64(s ^ 0x9E37_79B9_7F4A_7C15);
+            g.apply_root_action(a, &mut r)?;
+            sum += play_out(g, s)?;
+        }
+        return Ok((sum / k as f64, true));
+    }
+    let child_actions = probe.list_actions()?;
+    let mut sums = vec![0.0f64; child_actions.len()];
+    let mut cnt = 0usize;
+    for ki in 0..k {
+        let s = mix(seed, ki);
+        let mut base = game.fork_for_rollout(s);
+        let mut r = StdRng::seed_from_u64(s ^ 0xA1B2_C3D4_5E6F_7081);
+        base.apply_root_action(a, &mut r)?;
+        if !to_next_train(&mut base, s)? {
+            break;
+        }
+        for (j, b) in child_actions.iter().enumerate() {
+            let mut g = base.clone();
+            let mut r2 = StdRng::seed_from_u64(s ^ 0xB00B_5EED_0000_0001 ^ j as u64);
+            g.apply_root_action(b, &mut r2)?;
+            sums[j] += play_out(g, s)?;
+        }
+        cnt += 1;
+    }
+    if cnt == 0 || sums.is_empty() {
+        return Ok((0.0, true));
+    }
+    Ok((
+        sums.iter().fold(f64::NEG_INFINITY, |m, x| m.max(x / cnt as f64)),
+        false,
+    ))
+}
+
+/// 2026-11-04 #41 测量开关（只活在壳里，永不并回主仓）：
+/// `MC_NO_FORCED=1` 关掉発表会兜底，用来配对量「兜底买掉的演目达标确定性」值多少人头。
+fn forced_off() -> bool {
+    static OFF: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *OFF.get_or_init(|| std::env::var("MC_NO_FORCED").map(|v| v == "1").unwrap_or(false))
+}
+
+/// 発表会兜底（与 `mccli::run` 末尾那条排序约束同一件事）：
+/// 临近检查点且有演目未达标 ⇒ 强制改成练/稽古「最接近达标」的那一格，搜索分数让位。
+fn forced_target(game: &MatsuriGame, actions: &[Action]) -> Option<usize> {
+    if forced_off() {
+        return None;
+    }
+    let cp = game
+        .data
+        .check_points
+        .iter()
+        .find(|c| c.turn >= game.turn)
+        .cloned()?;
+    if cp.turn - game.turn > 15 {
+        return None;
+    }
+    let idx = (0..5usize)
+        .filter(|i| game.act_level[*i] < cp.need)
+        .min_by_key(|i| (cp.need - game.act_level[*i], -game.act_gauge[*i]))?;
+    actions.iter().position(|a| {
+        matches!(a, Action::Train(i) | Action::Keiko(i) if *i as usize == idx)
+    })
+}
+
+/// 出了搜索就把打点打开（`?` 提前返回也走这里，避免整臂静默失聪）
+struct RestoreRecord;
+
+impl Drop for RestoreRecord {
+    fn drop(&mut self) {
+        train_legs::set_record(true);
+    }
+}
+
+/// 2-ply 搜索决策者（`Trainer` 的强策档实现）
+pub struct SearchTrainer {
+    k: usize,
+    game_seed: Cell<u64>,
+    step: Cell<u64>,
+    /// 诊断：走单步分支（已无下一步训练）的决策数
+    endgame: Cell<u64>,
+    /// 诊断：被発表会兜底改掉的决策数
+    forced: Cell<u64>,
+    /// 诊断：非训练阶段的决策（委托给基策）次数
+    off_stage: Cell<u64>,
+}
+
+impl SearchTrainer {
+    pub fn new(k: usize) -> Self {
+        Self {
+            k: k.max(1),
+            game_seed: Cell::new(0),
+            step: Cell::new(0),
+            endgame: Cell::new(0),
+            forced: Cell::new(0),
+            off_stage: Cell::new(0),
+        }
+    }
+
+    /// 每局开跑前调用：固定本局搜索的种子基，并把诊断计数清零
+    pub fn begin_game(&self, seed: u64) {
+        self.game_seed.set(seed);
+        self.step.set(0);
+        self.endgame.set(0);
+        self.forced.set(0);
+        self.off_stage.set(0);
+    }
+
+    /// `(训练决策数, 其中走单步分支, 其中被発表会兜底改掉, 非训练阶段委托基策)`
+    pub fn diagnostics(&self) -> [u64; 4] {
+        [
+            self.step.get(),
+            self.endgame.get(),
+            self.forced.get(),
+            self.off_stage.get(),
+        ]
+    }
+}
+
+impl Trainer<MatsuriGame> for SearchTrainer {
+    fn select_action(
+        &self,
+        game: &MatsuriGame,
+        actions: &[Action],
+        rng: &mut StdRng,
+    ) -> Result<usize> {
+        // 非训练决策点（比赛/事件里其它动作）委托基策，保持与基策臂同一条事件流
+        if game.stage().get() != STAGE_TRAIN {
+            self.off_stage.set(self.off_stage.get() + 1);
+            return MatsuriRolloutTrainer.select_action(game, actions, rng);
+        }
+        let base = self.game_seed.get().wrapping_add(self.step.get() * GOLDEN_B);
+        self.step.set(self.step.get() + 1);
+        // 搜索期间的推演不进打点表
+        train_legs::set_record(false);
+        let _restore = RestoreRecord;
+        let mut best: (f64, usize, bool) = (f64::NEG_INFINITY, 0usize, false);
+        // 每一格的根估值（同格有 Train/Keiko 两条动作时取高的那条）：估值打点用
+        let mut slot_value = [None::<f64>; 5];
+        for (i, a) in actions.iter().enumerate() {
+            let (score, single) = root_value(game, a, self.k, base.wrapping_add(i as u64 * GOLDEN_A))?;
+            if let Some(s) = match a {
+                Action::Train(j) | Action::Keiko(j) => slot_value.get_mut((usize::from(*j)).min(4)),
+                _ => None,
+            } {
+                *s = Some(s.map_or(score, |old: f64| old.max(score)));
+            }
+            if score > best.0 {
+                best = (score, i, single);
+            }
+        }
+        train_legs::set_record(true);
+        if best.2 {
+            self.endgame.set(self.endgame.get() + 1);
+        }
+        let mut pick = best.1;
+        if let Some(f) = forced_target(game, actions) {
+            if f != pick {
+                self.forced.set(self.forced.get() + 1);
+            }
+            pick = f;
+        }
+        // 根决策的盘面打点：这格站了几个支援卡人头（与基策臂同一个 `board_obs`）
+        let obs = train_legs::board_obs(game, {
+            match &actions[pick] {
+                Action::Train(i) | Action::Keiko(i) => (usize::from(*i)).min(4),
+                _ => usize::MAX,
+            }
+        });
+        train_legs::record_board(&obs);
+        train_legs::record_root_value(&train_legs::RootValObs {
+            slot_heads: obs.slot_heads,
+            slot_value,
+            camp: obs.camp,
+        });
+        Ok(pick)
+    }
+
+    fn select_choice(
+        &self,
+        game: &MatsuriGame,
+        choices: &[Vec<umaai_core::gamedata::EventChoice>],
+        rng: &mut StdRng,
+    ) -> Result<usize> {
+        // 事件选项与基策档逐字一致 ⇒ 两臂只差在训练决策层
+        MatsuriRolloutTrainer.select_choice(game, choices, rng)
+    }
+}
