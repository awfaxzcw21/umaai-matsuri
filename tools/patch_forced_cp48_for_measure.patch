diff --git a/crates/matsuri-core/src/game/train_legs.rs b/crates/matsuri-core/src/game/train_legs.rs
new file mode 100644
index 0000000..b7d9be2
--- /dev/null
+++ b/crates/matsuri-core/src/game/train_legs.rs
@@ -0,0 +1,344 @@
+//! 训练腿分解打点（**测量壳专用，不并回 HEAD**）
+//!
+//! #40 要回答的是「引擎训练腿 PT 只有真机一半，丢在哪个乘区」，所以这里不只要 PT 的总数，
+//! 而是把 `training_leg` 的**分解**记下来：基础值 `base_pt` → 教诲/训练效果乘区 `pt_mult`
+//! → 彩圈+友情乘区 `friend_mult`，再按 (训练Lv, **支援卡人头**) 分桶。
+//!
+//! 分桶键只数 `PersonType::Card`，不是数全部人头：板上报文 `training_partner_array` 里
+//! `<100` 的那些就是卡组位，`>=100` 的是剧本成员/NPC/记者/理事长，而引擎的
+//! `base.distribution` 把**所有** person 类型都装进去（`gain_act_gauge_from_train` 那段
+//! 明确写了记者/理事长/友人不算担当）。两侧只有按「支援卡人头」对齐才是同一个变量。
+//!
+//! 真机侧同位置可比量 = 板上报文 `home_info` 的 `target_type=30`
+//! （`tools/train_leg_preview.py`）。关键判据是 **Pt/Σ五维 比值**：引擎里 PT 与五维共用
+//! `pt_mult`/`friend_mult`，比值对人头应近似不变；真机比值却随人头从 0.47 涨到 1.0
+//! ⇒ 结构性差异，不是系数大小。
+
+use std::cell::RefCell;
+
+pub const LV_N: usize = 6; // 下标 1..=5（训练 Lv）
+pub const CARD_N: usize = 8; // 0..=7（支援卡人头）
+
+/// 一格：`[hands, pt_sum, base_pt_sum, five_sum, vital_sum, pt_mult_x1000, friend_x1000,
+///        effect_pct_x10, friend_pct_x10, shining_hands, shining_heads_sum,
+///        heads_total_sum, h_card_sum, h_team_sum, h_npc_sum, h_other_sum]`
+pub type Cell = [i64; 16];
+
+pub const COLS: [&str; 16] = [
+    "hands",
+    "pt_sum",
+    "base_pt_sum",
+    "five_sum",
+    "vital_sum",
+    "pt_mult_x1000",
+    "friend_x1000",
+    "effect_pct_x10",
+    "friend_pct_x10",
+    "shining_hands",
+    "shining_heads_sum",
+    "heads_total_sum",
+    "h_card_sum",
+    "h_team_sum",
+    "h_npc_sum",
+    "h_other_sum",
+];
+
+#[derive(Debug, Clone, Copy)]
+pub struct LegObs {
+    pub lv: usize,
+    pub card_heads: usize,
+    pub heads_total: i64,
+    pub h_card: i64,
+    pub h_team: i64,
+    pub h_npc: i64,
+    pub h_other: i64,
+    pub shining_heads: usize,
+    pub pt: i64,
+    pub base_pt: i64,
+    pub five: i64,
+    pub vital: i64,
+    pub pt_mult: f64,
+    pub friend_mult: f64,
+    pub effect_pct: f64,
+    pub friend_pct: f64,
+}
+
+thread_local! {
+    // 第 0 层 = 普通训练结算，第 1 层 = 稽古的 home 腿
+    static TABLE: RefCell<[[[Cell; CARD_N]; LV_N]; 2]> =
+        const { RefCell::new([[[[0i64; 16]; 8]; 6]; 2]) };
+    // #41 强策档臂：搜索内部的推演不该进表，只有**根决策 + 它的结算**进。
+    // 默认开 ⇒ `matsuri-dist` 旧臂读数逐字不变。
+    static RECORD: RefCell<bool> = const { RefCell::new(true) };
+}
+
+/// 打点开关（测量壳专用）：`false` = 后续 `record_*` 全部空转。
+pub fn set_record(on: bool) {
+    RECORD.with(|r| *r.borrow_mut() = on);
+}
+
+pub fn record_on() -> bool {
+    RECORD.with(|r| *r.borrow())
+}
+
+fn bump(slot: usize, o: &LegObs) {
+    if !record_on() {
+        return;
+    }
+    let l = o.lv.clamp(0, LV_N - 1);
+    let h = o.card_heads.clamp(0, CARD_N - 1);
+    TABLE.with(|t| {
+        let c = &mut t.borrow_mut()[slot][l][h];
+        c[0] += 1;
+        c[1] += o.pt;
+        c[2] += o.base_pt;
+        c[3] += o.five;
+        c[4] += o.vital;
+        c[5] += (o.pt_mult * 1000.0) as i64;
+        c[6] += (o.friend_mult * 1000.0) as i64;
+        c[7] += (o.effect_pct * 10.0) as i64;
+        c[8] += (o.friend_pct * 10.0) as i64;
+        c[9] += if o.shining_heads > 0 { 1 } else { 0 };
+        c[10] += o.shining_heads as i64;
+        c[11] += o.heads_total;
+        c[12] += o.h_card;
+        c[13] += o.h_team;
+        c[14] += o.h_npc;
+        c[15] += o.h_other;
+    });
+}
+
+/// 普通训练那一条（`do_train` 成功结算处）
+pub fn record_train(o: &LegObs) {
+    bump(0, o);
+}
+
+/// 稽古的 home 腿（`do_keiko_impl` 里 `self.training_leg(idx)` 那一份）
+pub fn record_keiko_home(o: &LegObs) {
+    bump(1, o);
+}
+
+pub fn reset() {
+    TABLE.with(|t| *t.borrow_mut() = [[[[0i64; 16]; 8]; 6]; 2]);
+    BOARD.with(|b| *b.borrow_mut() = [[0i64; 20]; 2]);
+    VALUE.with(|v| *v.borrow_mut() = [[0f64; 30]; 2]);
+    CP.with(|c| *c.borrow_mut() = [[0f64; 4]; CP_SLOTS]);
+}
+
+pub fn get() -> [[[Cell; CARD_N]; LV_N]; 2] {
+    TABLE.with(|t| *t.borrow())
+}
+
+// ── 盘面打点：一手决策前，5 个训练位上各站了几个**支援卡**人头 ────────────────────
+//
+// 要回答的是 #40 的归属问题：`人头分布效应 −985 Pt/局` 到底是
+// **站位模型**没把卡组堆到一起（盘面就没这种格），还是堆得出而**选位策略**不去站。
+// 真机侧同口径已有（`out/train_leg_preview_20261103.csv` 每块板的每个位）：
+// 真机盘面 98% 的手都有 ≥2 卡的格可站，且 80.6% 的手选中了盘面人头最多的那一格。
+
+/// `[boards, max_hist0..max_hist7, sum_slot_heads, chosen_n, chosen_hist0..chosen_hist7, take_max]`
+pub const BOARD_COLS: [&str; 20] = [
+    "boards",
+    "max0", "max1", "max2", "max3", "max4", "max5", "max6", "max7",
+    "sum_slot_heads",
+    "chosen_n",
+    "ch0", "ch1", "ch2", "ch3", "ch4", "ch5", "ch6", "ch7",
+    "take_max",
+];
+
+pub struct BoardObs {
+    /// 每个训练位上的支援卡人头数（长度 5）
+    pub slot_heads: [i64; 5],
+    /// 选中的槽位；`usize::MAX` = 这手不是训练/稽古
+    pub chosen: usize,
+    pub camp: bool,
+}
+
+thread_local! {
+    // 第 0 层 = 非合宿回合，第 1 层 = 合宿回合（稽古）
+    static BOARD: RefCell<[[i64; 20]; 2]> = const { RefCell::new([[0i64; 20]; 2]) };
+}
+
+/// 一手决策前的盘面快照：5 个训练位各站了几个**支援卡**人头 + 这手落在哪格。
+///
+/// 只数 `PersonType::Card`（= 真机报文 `training_partner_array` 里 `<100` 的卡组位）。
+/// rollout 臂与 2-ply 搜索臂共用这一份，两个臂的「人头」才是同一个变量。
+pub fn board_obs(game: &super::MatsuriGame, chosen: usize) -> BoardObs {
+    let mut slot_heads = [0i64; 5];
+    for (s, h) in slot_heads.iter_mut().enumerate() {
+        if let Some(d) = game.distribution.get(s) {
+            *h = d
+                .iter()
+                .filter(|&&p| p >= 0)
+                .filter(|&&p| {
+                    matches!(
+                        game.persons.get(p as usize).map(|q| q.person_type),
+                        Some(umasim::game::PersonType::Card)
+                    )
+                })
+                .count() as i64;
+        }
+    }
+    BoardObs {
+        slot_heads,
+        chosen,
+        camp: game.is_camp_turn(),
+    }
+}
+
+pub fn record_board(o: &BoardObs) {
+    if !record_on() {
+        return;
+    }
+    let mx = o.slot_heads.iter().max().copied().unwrap_or(0);
+    let l = usize::from(o.camp);
+    BOARD.with(|b| {
+        let r = &mut b.borrow_mut()[l];
+        r[0] += 1;
+        r[1 + mx.clamp(0, 7) as usize] += 1;
+        for h in o.slot_heads {
+            r[9] += h.clamp(0, 7);
+        }
+        if o.chosen != usize::MAX {
+            if let Some(h) = o.slot_heads.get(o.chosen).copied() {
+                r[10] += 1;
+                r[11 + h.clamp(0, 7) as usize] += 1;
+                if h == mx {
+                    r[19] += 1;
+                }
+            }
+        }
+    });
+}
+
+pub fn board_get() -> [[i64; 20]; 2] {
+    BOARD.with(|b| *b.borrow())
+}
+
+// ── 估值打点（#41 第二刀）：根决策时，引擎自己给 5 个训练位打的分数 ────────────────
+//
+// take/offer 只能说明「最后落了哪格」，说不清是**估值看不见人头**还是**搜索太吵/兜底改判**。
+// 这里直接记引擎给每一格的根估值：
+//   · 估值最优格的人头均值 —— 和「盘面最满格人头」比：两者差多少 = 估值这一刀丢掉的；
+//     再和「实际落子人头」比：又差多少 = 噪声 + 発表会兜底丢掉的。
+//   · 人头 vs 估值的配对一致率 —— 同盘两格，人头多的那一格估值是否也高。
+// ⚠ 这是**相关性**读数，不是因果：人头多的格常常同时也是别的条件好的格。
+// 因果那一刀留给 #42（同估值改站位的双臂）。
+
+/// `[roots, amax0..amax7, sum_amax_heads, sum_offer_max_heads, concord, discord, tie,
+/// val_sum_h0..val_sum_h7, slot_n_h0..slot_n_h7]`
+pub const VALUE_COLS: [&str; 30] = [
+    "roots",
+    "amax0", "amax1", "amax2", "amax3", "amax4", "amax5", "amax6", "amax7",
+    "sum_amax_heads",
+    "sum_offer_max_heads",
+    "concord", "discord", "tie",
+    "val_h0", "val_h1", "val_h2", "val_h3", "val_h4", "val_h5", "val_h6", "val_h7",
+    "slot_n0", "slot_n1", "slot_n2", "slot_n3", "slot_n4", "slot_n5", "slot_n6", "slot_n7",
+];
+
+pub struct RootValObs {
+    /// 每个训练位的人头（与 `BoardObs` 同一个定义）
+    pub slot_heads: [i64; 5],
+    /// 每个训练位的根估值；`None` = 这手这格没有可落的动作
+    pub slot_value: [Option<f64>; 5],
+    pub camp: bool,
+}
+
+thread_local! {
+    static VALUE: RefCell<[[f64; 30]; 2]> = const { RefCell::new([[0f64; 30]; 2]) };
+}
+
+pub fn record_root_value(o: &RootValObs) {
+    if !record_on() {
+        return;
+    }
+    let live: Vec<usize> = (0..5).filter(|i| o.slot_value[*i].is_some()).collect();
+    if live.len() < 2 {
+        return;
+    }
+    let amax = live
+        .iter()
+        .copied()
+        .max_by(|a, b| o.slot_value[*a].unwrap().partial_cmp(&o.slot_value[*b].unwrap()).unwrap())
+        .unwrap();
+    let offer_max = live.iter().map(|i| o.slot_heads[*i]).max().unwrap_or(0);
+    let mut conc = 0f64;
+    let mut disc = 0f64;
+    let mut tie = 0f64;
+    for x in 0..live.len() {
+        for y in (x + 1)..live.len() {
+            let (i, j) = (live[x], live[y]);
+            let dh = o.slot_heads[i] - o.slot_heads[j];
+            let dv = o.slot_value[i].unwrap() - o.slot_value[j].unwrap();
+            if dh == 0 || dv.abs() <= f64::EPSILON {
+                tie += 1.0;
+            } else if (dh > 0) == (dv > 0.0) {
+                conc += 1.0;
+            } else {
+                disc += 1.0;
+            }
+        }
+    }
+    let l = usize::from(o.camp);
+    VALUE.with(|v| {
+        let r = &mut v.borrow_mut()[l];
+        r[0] += 1.0;
+        r[1 + o.slot_heads[amax].clamp(0, 7) as usize] += 1.0;
+        r[9] += o.slot_heads[amax] as f64;
+        r[10] += offer_max as f64;
+        r[11] += conc;
+        r[12] += disc;
+        r[13] += tie;
+        for i in live {
+            let h = o.slot_heads[i].clamp(0, 7) as usize;
+            r[14 + h] += o.slot_value[i].unwrap();
+            r[22 + h] += 1.0;
+        }
+    });
+}
+
+pub fn value_get() -> [[f64; 30]; 2] {
+    VALUE.with(|v| *v.borrow())
+}
+
+// ── 発表会打点：每场检查点的档位与「差多少级到大成功」────────────────────────────
+//
+// #48：搜索臂的「発表会兜底」会把决策强行改到最接近达标的格。要分清它买到的是
+// **确定性**（大成功 buff）还是**白丢的人头**，只看人头不够——档位在 buff 上，
+// 不在人头上。故每场记 `[结算数, 大成功数, Σ(min(Lv)−need), Σ未达标演目数]`。
+
+pub const CP_SLOTS: usize = 4;
+
+pub const CP_COLS: [&str; 4] = ["n", "great", "margin_sum", "deficient_sum"];
+
+pub struct CheckPointObs {
+    /// 第几场（`check_points` 里的下标）
+    pub slot: usize,
+    pub great: bool,
+    /// `min(全演目 Lv) − need`：负数 = 差几级没到大成功
+    pub margin: i32,
+    /// 未达标（Lv < need）的演目个数
+    pub deficient: i32,
+}
+
+thread_local! {
+    static CP: RefCell<[[f64; 4]; CP_SLOTS]> = const { RefCell::new([[0f64; 4]; CP_SLOTS]) };
+}
+
+pub fn record_check_point(o: &CheckPointObs) {
+    if !record_on() || o.slot >= CP_SLOTS {
+        return;
+    }
+    CP.with(|c| {
+        let r = &mut c.borrow_mut()[o.slot];
+        r[0] += 1.0;
+        r[1] += if o.great { 1.0 } else { 0.0 };
+        r[2] += o.margin as f64;
+        r[3] += o.deficient as f64;
+    });
+}
+
+pub fn cp_get() -> [[f64; 4]; CP_SLOTS] {
+    CP.with(|c| *c.borrow())
+}
