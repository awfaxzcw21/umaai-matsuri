+//! 稽古分腿打点（**测量壳专用，不并回 HEAD**）· #39
+//!
+//! 一手报文（`docs/稽古PT逐手曲线_20261103.md`）证实稽古实到 = **home 腿 + 演目腿**，
+//! 但逐 Lv 的缺口到底落在哪条腿，引擎侧此前只能靠整体 PT 反推。这里在结算点把两条腿
+//! 按「本手用的演目板等级」分开记账，直接出对照表。
+//!
+//! 状态用 `thread_local`，不进 `MatsuriGame`：避免污染序列化与 `fork_for_rollout`。
+
+use std::cell::RefCell;
+
+/// Lv 桶数（下标 1..=10 是真实等级，0 与 11 是越界保护）
+pub const LV_N: usize = 12;
+
+/// 一列 = `[手数, 失败手数, home腿PT, 演目腿PT, home腿五维和, 演目腿五维和, 追加稽古手数]`
+pub type LegRow = [i64; 7];
+
+pub const LEG_COLS: [&str; 7] = [
+    "hands",
+    "failed",
+    "home_leg_pt",
+    "act_leg_pt",
+    "home_leg_five",
+    "act_leg_five",
+    "extra_keiko",
+];
+
+thread_local! {
+    static KEIKO_LEGS: RefCell<[LegRow; LV_N]> = const { RefCell::new([[0i64; 7]; LV_N]) };
+}
+
+/// 记一手稽古（失败手只进分母，不进腿值——失败不发任何收益）
+pub fn keiko_leg(
+    level: usize,
+    failed: bool,
+    extra: bool,
+    home_leg_pt: i32,
+    act_leg_pt: i32,
+    home_leg_five: i32,
+    act_leg_five: i32,
+) {
+    // 与 `train_legs` 同一把开关：搜索臂只记根决策的结算，推演内部不进表。
+    if !super::train_legs::record_on() {
+        return;
+    }
+    KEIKO_LEGS.with(|k| {
+        let row = &mut k.borrow_mut()[level.min(LV_N - 1)];
+        row[0] += 1;
+        if failed {
+            row[1] += 1;
+        } else {
+            row[2] += i64::from(home_leg_pt);
+            row[3] += i64::from(act_leg_pt);
+            row[4] += i64::from(home_leg_five);
+            row[5] += i64::from(act_leg_five);
+        }
+        if extra {
+            row[6] += 1;
+        }
+    });
+}
+
+/// 清零（每局开跑前）
+pub fn reset() {
+    KEIKO_LEGS.with(|k| *k.borrow_mut() = [[0i64; 7]; LV_N]);
+}
+
+/// 读出分腿累计（下标 = 演目 Lv）
+pub fn get() -> [LegRow; LV_N] {
+    KEIKO_LEGS.with(|k| *k.borrow())
+}
