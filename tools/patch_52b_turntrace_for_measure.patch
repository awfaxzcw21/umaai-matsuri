+/// 测量壳插桩（**永不并回主仓**）：逐 turn 轨迹缓冲。
+/// 行格式（TAB 分隔）：`turn \t win(0/1) \t gauge0:..:gauge4 \t act0:..:act4 \t mot \t 被应用的动作`
+/// —— 记的是**这一手出手前**的快照；出手后的账由下一行的「出手前」给出（与报文同回合配对口径一致）。
+thread_local! {
+    static TURN_TRACE: std::cell::RefCell<Vec<String>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// 取走并清空当前线程的轨迹缓冲（`matsuri-dist` 每局结束后调用）。
+pub fn drain_turn_trace() -> Vec<String> {
+    TURN_TRACE.with(|t| std::mem::take(&mut *t.borrow_mut()))
+}
