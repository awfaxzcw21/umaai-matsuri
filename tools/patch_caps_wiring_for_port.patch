+//! 剧本五维上限接线守门（2026-11-02 复核线，报文一手依据）
+//!
+//! `Limits` 里的剧本上限 `[2200, 1850, 1800, 1700, 1800]` 原本只被反序列化 +
+//! `validate_limits()` 校验，**没有任何运行时读取点** ⇒ 实际钳位用引擎通用
+//! `consts.five_status_limit_base` = `[3100, 2400, 2200, 2200, 2400]`（通用剧本默认值，
+//! 比剧本口径宽 500~900，高档属性不受钳；实测表现为速度跑到 3,179）。
+//!
+//! 一手依据：真机 t30 报文 `stat_caps` = 2225 / 1850 / 1848 / 1700 / 1816
+//! （`crates/matsuri-cli/tests/data/state_t30.json`），其中耐力、根性恰等于剧本基础值
+//! ⇒ 基础值口径成立，另三维的零头来自演目 Lv9/10 与教诲的上限加成。
+
+use std::sync::Arc;
+
+use anyhow::{Context, Result};
+use matsuri_core::testing::data_dir;
+use matsuri_core::{MatsuriData, MatsuriGame};
+use umaai::Config;
+use umaai_core::Data;
+
+#[test]
+fn newgame_seeds_limits_from_scenario_not_engine_defaults() -> Result<()> {
+    let root = data_dir();
+    let cfg = Config::load_with_overlay_file(&root, ".").context("载入配置失败")?;
+    Data::init(&root)?;
+    let data = Arc::new(MatsuriData::load(&root).context("载入剧本数据失败")?);
+    let expected = data.limits.five_status_limit_base;
+    let game = MatsuriGame::newgame(
+        cfg.sim.uma,
+        &cfg.sim.cards,
+        cfg.inherit(),
+        cfg.race_grades()?,
+        Arc::clone(&data),
+    )?;
+
+    // 初始上限 = 剧本 base + 继承加成（`umasim` 在 newgame 里 `add_eq(newgame_limit_inherit)`，
+    // 按卡种逐维给零头：本卡组实测速度 +79 / 耐力 +15，其余 +0）。
+    // 真机 t30 的零头（速 +25 / 力 +48 / 智 +16）正是这种**逐维不等**的形态
+    // ⇒ 来源是继承，不是我们那条「同值摊到五维」的演目/教诲加成（已知近似）。
+    let limit = game.view().uma.five_status_limit;
+    let generic = Data::get()?.consts.five_status_limit_base;
+    assert_eq!(
+        expected,
+        [2200, 1850, 1800, 1700, 1800],
+        "剧本上限数值本身（真机报文 `stat_caps` 口径）"
+    );
+    for i in 0..5 {
+        assert!(
+            limit[i] >= expected[i],
+            "第 {i} 维 {} 低于剧本基础值 {} ⇒ 剧本上限没接上",
+            limit[i],
+            expected[i]
+        );
+        assert_ne!(
+            limit[i], generic[i],
+            "第 {i} 维仍等于引擎通用默认 {} ⇒ 钳位没接到剧本 `limits`",
+            generic[i]
+        );
+        assert!(
+            limit[i] <= expected[i] + 100,
+            "第 {i} 维 {} 超出「剧本基础 + 继承零头」的形态（base {}）",
+            limit[i],
+            expected[i]
+        );
+    }
+    Ok(())
+}
