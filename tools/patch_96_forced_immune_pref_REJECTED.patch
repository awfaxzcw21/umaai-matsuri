+    // 【#96 改法·测量壳开关 UMA_FORCED_IMMUNE_PREF】兜底原来只按「最接近达标」选格，
+    // 不看那一格当前会不会失败 ⇒ 20% 的训练决策被逼到低体力高失败率的格子上（§20.3）。
+    // 开启后：先挑「这一手失败已被教诲豁免」的档，再按原口径 (距达标, 槽) 排。
+    let immune = std::env::var("UMA_FORCED_IMMUNE_PREF").is_ok();
     let idx = (0..5usize)
         .filter(|i| game.act_level[*i] < cp.need)
-        .min_by_key(|i| (cp.need - game.act_level[*i], -game.act_gauge[*i]))?;
+        .min_by_key(|i| {
+            (
+                if immune { !game.act_fail_immune(*i) } else { false },
+                cp.need - game.act_level[*i],
+                -game.act_gauge[*i],
+            )
+        })?;
     actions
         .iter()
         .position(|a| matches!(a, Action::Train(i) | Action::Keiko(i) if *i as usize == idx))
